{
  "watch": ["src"],
  "ext": "ts,js,json",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist",
    "*.log"
  ],
  "exec": "ts-node --transpile-only src/server.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "1000",
  "verbose": true,
  "colours": true,
  "restartable": "rs",
  "legacyWatch": true,
  "polling": true,
  "events": {
    "restart": "echo \"🔄 Server restarted due to changes\"",
    "crash": "echo \"💥 Server crashed, restarting...\"",
    "exit": "echo \"👋 Server stopped\""
  }
} 